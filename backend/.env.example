# Server Configuration
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed Frontend & ERP origins for CORS
# Example for production: https://elysia-guest.vercel.app,https://elysia-erp.vercel.app
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:5174

# JWT Secret (Generate a strong 256-bit or 512-bit random string)
JWT_SECRET=your_super_secret_jwt_key_must_be_random_and_secure_here

# PostgreSQL Database Configuration
# Option 1: Single Connection String (Recommended for Neon / Supabase / Render / Railway)
# DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/hotel_db?sslmode=require

# Option 2: Individual Parameters (Local / VPS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_db
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here
DB_SSL=false

# Optional Staff Seed Account Initial Passwords (Overrides defaults during initial seed)
SEED_ADMIN_PASSWORD=your_custom_admin_password_here
SEED_MANAGER_PASSWORD=your_custom_manager_password_here
SEED_RECEPTIONIST_PASSWORD=your_custom_receptionist_password_here
